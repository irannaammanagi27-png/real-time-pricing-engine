spring.application.name=real-time-pricing-engine
server.port=8080

upstream.websocket.url=wss://v3-prod.livefxhub.com/ws/algo
upstream.api-key=YOUR_API_KEY
upstream.secret-key=YOUR_SECRET_KEY

spring.data.redis.host=localhost
spring.data.redis.port=6379

management.endpoints.web.exposure.include=health,info,metrics
management.endpoint.health.show-details=always